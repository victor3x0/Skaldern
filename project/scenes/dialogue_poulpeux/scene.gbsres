    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Mais passons ! \n",
          "Tu veux retrouver \nBarbe Noir, non ?",
          "Il faut commencer \nquelque part."
        ],
        "__section": "text",
        "avatarId": "",
        "minHeight": 4,
        "maxHeight": 7,
