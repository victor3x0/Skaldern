    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Cette plage est \ncouverte de\ncoquillages.",
          "Ces petites bêtes \nsont inutiles, et \ntrès désagréable",
          "pour ma voûte\nplantaire délicate."
        ],
        "__section": "text",
        "avatarId": "",
        "minHeight": 4,
        "maxHeight": 7,
        "textX": 1,
        "textY": 0,
        "textHeight": 5,
