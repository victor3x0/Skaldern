    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Morgana m'a prévenu \nde ton arrivée.\n",
          "C'est elle qui t'a\nremis sur pied, si\nl'on peut dire"
        ],
        "__section": "behavior",
        "avatarId": "",
        "minHeight": 4,
