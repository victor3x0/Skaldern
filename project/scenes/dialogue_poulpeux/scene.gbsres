    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Tu risque de tomber\nsur un vieux\ngeignard sur la \nroute.",
          "si d'aventure il \nn'est plus là à \nvotre retour, ",
          "j'aurais quelque \nchose pour vous. "
