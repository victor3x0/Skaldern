    },
    {
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Débarrasse-m'en, \net je t'ouvre \nla caverne.",
          "Elle est plus loin\nsur la plage",
          "Dix suffiront.\nCompte bien."
        ],
        "__section": "text",
        "avatarId": "",
        "minHeight": 4,
        "maxHeight": 7,
        "textX": 1,
        "textY": 0,
        "textHeight": 5,
